# Copy to .env and fill locally. This file is an example only; do not commit
# private endpoints, API keys, service-account paths, or proxy details.

# OpenClaw planning model for image generation.
ANTHROPIC_API_KEY=replace-me
OPENCLAW_MODEL_PROVIDER=anthropic
OPENCLAW_MODEL_ID=claude-sonnet-4-6
OPENCLAW_MODEL_BASE_URL=https://api.anthropic.com
OPENCLAW_MODEL_API_KEY_ENV=ANTHROPIC_API_KEY
OPENCLAW_MODEL_API=anthropic-messages
# Optional provider-specific headers. Values may use OpenClaw's ${ENV_NAME}
# substitution so secrets stay outside this file.
# OPENCLAW_MODEL_HEADERS_JSON={"x-api-key":"${PROVIDER_X_API_KEY}"}
OPENCLAW_MODEL_CONTEXT_WINDOW=200000
OPENCLAW_MODEL_ALLOW_PRIVATE_NETWORK=0
OPENCLAW_MAX_TOKENS=8192

# Official Gemini API: shared by image generation and the Gemini judge.
GEMINI_API_KEY=replace-me
AGENT_JUDGE_GEMINI_MODEL=gemini-3-flash-preview
OPENCLAW_JUDGE_PROVIDER=google
# Optional Vertex AI alternative (not required for the default setup):
# OPENCLAW_JUDGE_PROVIDER=google-vertex
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional overrides.
OPENCLAW_BIN=./openclaw-runtime/openclaw.mjs
NODE_BIN=node
OPENCLAW_THINKING=high
OPENCLAW_VERBOSE=full
TASK_TIMEOUT=90000
MCP_TOOL_TIMEOUT_MS=300000
# Optional: increase local OpenClaw gateway RPC timeout for subagent judge.
AGENT_JUDGE_OPENCLAW_GATEWAY_CALL_TIMEOUT_MS=300000

# Image generation backend config.
IMAGE_GEN_CONFIG=./examples/image_gen_config.example.json
LONGBANANA_DATA_ROOT=/path/to/longbanana/output_300

# Optional proxy config. Keep internal proxy hosts/domains only in your private
# .env, never in source code.
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1
